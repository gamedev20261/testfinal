{
  "info": {
    "name": "GeoAnnotator API",
    "description": "Requests for every patch of the GeoAnnotator rebuild. Each folder matches a patch in learn/patches/. Select the 'GeoAnnotator – Local' environment before sending requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Patch 01 · Health",
      "description": "Is the server running? No login needed.",
      "item": [
        {
          "name": "Health check",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Returns { status: 'ok', database: 'ok', time } when the API is up and can reach PostgreSQL.\nReturns 503 { status: 'error', database: 'unreachable' } when the database is down (try: docker compose stop db).\n\nWho can call it: anyone.\nUsed by: nothing on screen yet. Later, Docker uses it to check that the backend is healthy."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Body says ok', () => pm.expect(pm.response.json().status).to.eql('ok'));",
                  "pm.test('Database is reachable (patch 02)', () => pm.expect(pm.response.json().database).to.eql('ok'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown route → 404",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/does-not-exist",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "does-not-exist"
              ]
            },
            "description": "A URL with no route. The server answers 404 with a JSON error instead of an HTML page."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 404', () => pm.response.to.have.status(404));",
                  "pm.test('Body has an error message', () => pm.expect(pm.response.json().error).to.be.a('string'));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Patch 03 · Auth",
      "description": "Login, logout and 'who am I?'. Run the folder from top to bottom: it starts logged out, tries the failure cases, logs in, and logs out again.\n\nThe login cookie is stored by Postman automatically (see 'Cookies' under the Send button), just like a browser does.",
      "item": [
        {
          "name": "Logout (start clean)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Deletes the session cookie. Always answers 204 No Content, even when you were not logged in.\n\nUsed by: the Logout button (patch 06)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Who am I? (logged out) → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Returns { user: { id, name, email, role } } for the logged-in user, or 401 { error: 'Please log in' }.\n\nWho can call it: anyone; only a valid session cookie gets a 200.\nUsed by: the frontend when a page loads, to know who is logged in and which portal to show (patch 06)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 401', () => pm.response.to.have.status(401));",
                  "pm.test('Error says \"Please log in\"', () => pm.expect(pm.response.json().error).to.eql('Please log in'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login: empty body → 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "The body has no email and no password. Zod rejects it: 400, with `error` (the first problem, for a toast) and `issues` (every problem, one per field, for a form).",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error says \"Enter your email\"', () => pm.expect(pm.response.json().error).to.eql('Enter your email'));",
                  "pm.test('Lists both missing fields', () => pm.expect(pm.response.json().issues.map(i => i.field)).to.eql(['email', 'password']));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login: not an email → 400",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "The email is not a valid address.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"not-an-email\",\n  \"password\": \"anything\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error says \"Enter a valid email address\"', () => pm.expect(pm.response.json().error).to.eql('Enter a valid email address'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login: wrong password → 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "The email exists but the password is wrong. Note the message: it does not say which one was wrong.\n\nEvery failed login counts towards the limit of 20 per 15 minutes; after that you get 429.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"wrong-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 401', () => pm.response.to.have.status(401));",
                  "pm.test('Error says \"Invalid email or password\"', () => pm.expect(pm.response.json().error).to.eql('Invalid email or password'));",
                  "pm.test('No session cookie was set', () => pm.expect(pm.cookies.has('session')).to.be.false);"
                ]
              }
            }
          ]
        },
        {
          "name": "Login: unknown email → 401",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "No account has this email. The answer is exactly the same as for a wrong password, so nobody can discover which emails have an account.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"nobody@example.com\",\n  \"password\": \"wrong-password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 401', () => pm.response.to.have.status(401));",
                  "pm.test('Error says \"Invalid email or password\"', () => pm.expect(pm.response.json().error).to.eql('Invalid email or password'));"
                ]
              }
            }
          ]
        },
        {
          "name": "Login as admin → 200",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "description": "Correct email and password (from the environment variables adminEmail / adminPassword, which match ADMIN_EMAIL / ADMIN_PASSWORD in backend/.env).\n\nReturns { user: { id, name, email, role } } and a Set-Cookie header with the session cookie (HttpOnly, SameSite=Lax).\n\nWho can call it: anyone.\nUsed by: the Sign In button on the login screen (patch 06).",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const user = pm.response.json().user;",
                  "pm.test('Returns the admin', () => pm.expect(user.role).to.eql('ADMIN'));",
                  "pm.test('Never returns the password hash', () => pm.expect(user).to.not.have.property('passwordHash'));",
                  "pm.test('Session cookie was set', () => pm.expect(pm.cookies.has('session')).to.be.true);",
                  "pm.environment.set('userId', user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Who am I? (logged in) → 200",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Returns { user: { id, name, email, role } } for the logged-in user, or 401 { error: 'Please log in' }.\n\nWho can call it: anyone; only a valid session cookie gets a 200.\nUsed by: the frontend when a page loads, to know who is logged in and which portal to show (patch 06)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "pm.test('Same user as the login', () => pm.expect(pm.response.json().user.id).to.eql(pm.environment.get('userId')));"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout → 204",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            },
            "description": "Deletes the session cookie (the response sets it to an empty value that expired in 1970).\n\nUsed by: the Logout button (patch 06)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 204', () => pm.response.to.have.status(204));"
                ]
              }
            }
          ]
        },
        {
          "name": "Who am I? (after logout) → 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "me"
              ]
            },
            "description": "Returns { user: { id, name, email, role } } for the logged-in user, or 401 { error: 'Please log in' }.\n\nWho can call it: anyone; only a valid session cookie gets a 200.\nUsed by: the frontend when a page loads, to know who is logged in and which portal to show (patch 06)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 401', () => pm.response.to.have.status(401));",
                  "pm.test('Error says \"Please log in\"', () => pm.expect(pm.response.json().error).to.eql('Please log in'));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
