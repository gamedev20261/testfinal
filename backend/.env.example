# Copy this file to `.env` and change the values.
# `.env` is ignored by git, so your secrets never leave your computer.

# development | production | test
NODE_ENV=development

# Port the API listens on: http://localhost:3001
PORT=3001

# How much the server logs: debug | info | warn | error
LOG_LEVEL=info

# PostgreSQL connection: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# These values match docker-compose.yml.
DATABASE_URL=postgresql://geo:geo_dev_password@localhost:5432/geoannotator

# The first administrator, created by `npm run db:seed`
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
