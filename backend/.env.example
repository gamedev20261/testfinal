# Copy this file to `.env` and change the values.
# `.env` is ignored by git, so your secrets never leave your computer.

# development | production | test
NODE_ENV=development

# Port the API listens on: http://localhost:3001
PORT=3001

# How much the server logs: debug | info | warn | error
LOG_LEVEL=info

# PostgreSQL (with PostGIS) connection: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# These values match docker-compose.yml.
DATABASE_URL=postgresql://geo:geo_dev_password@localhost:5432/geoannotator
# PostgreSQL installed on your computer (pgAdmin) instead of Docker? Use its "postgres" user
# and the password you chose when installing it (see learn/local-postgres.md):
# DATABASE_URL=postgresql://postgres:YOUR_POSTGRES_PASSWORD@localhost:5432/geoannotator

# Secret key that signs login sessions: at least 32 random characters.
# Anyone who knows it can forge a login, so use your own and never share it.
# Make one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-secret-replace-me-with-64-random-hex-chars

# How long a login lasts before the user must sign in again (hours)
SESSION_HOURS=24

# Folder for uploaded images, thumbnails and map tiles (relative to backend/)
UPLOAD_DIR=uploads
# Largest image file that can be uploaded (MB)
MAX_UPLOAD_MB=2048
# How many images are processed at the same time (more = faster but uses more memory)
IMAGE_WORKERS=1

# The first administrator, created by `npm run db:seed`
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe123!

# Demo accounts annotator@example.com and auditor@example.com, plus demo label classes
# (also created by `npm run db:seed`; set to false to skip them)
SEED_DEMO_USERS=true
DEMO_PASSWORD=ChangeMe123!
