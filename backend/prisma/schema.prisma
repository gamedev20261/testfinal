// The database schema: every table, its columns, and how tables relate.
// After changing this file, run `npm run db:migrate` to update the database.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// The three portals: decides what a user sees after logging in
enum Role {
  ADMIN
  ANNOTATOR
  AUDITOR
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique // always stored in lowercase
  passwordHash String
  role         Role     @default(ANNOTATOR)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}
